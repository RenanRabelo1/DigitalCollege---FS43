PORT=3000
NODE_ENV=development

# Neon Console > Connect > copie a connection string com SSL habilitado.
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_POOL_MAX=10

# Use uma sequência aleatória com pelo menos 32 caracteres.
JWT_SECRET=troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres
JWT_EXPIRES_IN=8h

# Separe múltiplas origens por vírgula.
FRONTEND_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000
